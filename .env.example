# Smart Grid Renewable Energy Forecasting Configuration
# OpenWeather API Key (Sign up at https://openweathermap.org/api)
#
# OPENWEATHER_API_KEY=
ALLOWED_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# API authentication
AUTH_ENABLED=false
API_KEY=replace_with_a_long_random_value
MAX_UPLOAD_BYTES=52428800
RATE_LIMIT_UPLOAD=5
RATE_LIMIT_TRAIN=3
RATE_LIMIT_REPORT=10
RATE_LIMIT_PREDICT=30
RATE_LIMIT_WINDOW_SECONDS=60
# Limits are in-memory: they reset on restart, are per worker, and are not
# suitable for distributed deployments without a shared rate-limit store.

# Database URL (SQLite default; MySQL example: mysql+pymysql://user:password@localhost:3306/smart_grid)
DATABASE_URL=sqlite:///./data/smart_grid.db

# Server Host & Port
HOST=127.0.0.1
PORT=8000
DEBUG=True
